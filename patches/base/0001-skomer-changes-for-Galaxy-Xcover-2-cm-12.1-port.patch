+    // ---- Volume key torch (screen off) ----
+    private boolean mVolumeTorchKeyHandled;
+    private PowerManager.WakeLock mVolumeTorchWakeLock;
+
+    private final Runnable mVolumeTorchLongPress = new Runnable() {
+        @Override
+        public void run() {
+            try {
+                android.hardware.TorchManager tm = (android.hardware.TorchManager)
+                        mContext.getSystemService(Context.TORCH_SERVICE);
+                if (tm != null && tm.isAvailable() && !tm.isTorchOn()) {
+                    tm.setTorchEnabled(true);
+                    scheduleVolumeTorchAutoOff();
+                }
+            } catch (Exception e) {
+                Slog.w(TAG, "Volume torch: could not turn torch on", e);
+            }
+        }
+    };
+
+    private final Runnable mVolumeTorchAutoOff = new Runnable() {
+        @Override
+        public void run() {
+            try {
+                android.hardware.TorchManager tm = (android.hardware.TorchManager)
+                        mContext.getSystemService(Context.TORCH_SERVICE);
+                if (tm != null && tm.isTorchOn()) {
+                    tm.setTorchEnabled(false);
+                }
+            } catch (Exception e) {
+                Slog.w(TAG, "Volume torch: auto-off failed", e);
+            }
+        }
+    };
+
+    private void scheduleVolumeTorchAutoOff() {
+        int secs = Settings.System.getInt(mContext.getContentResolver(),
+                "volume_torch_timeout", 300);
+        mHandler.removeCallbacks(mVolumeTorchAutoOff);
+        if (secs > 0) {
+            mHandler.postDelayed(mVolumeTorchAutoOff, secs * 1000L);
+        }
+    }
+
+    // Returns true if the key event was consumed.
+    private boolean handleVolumeTorchKey(boolean down, int repeatCount) {
+        if (Settings.System.getInt(mContext.getContentResolver(),
+                "volume_torch_enabled", 1) == 0) {
+            return false;
+        }
+        android.hardware.TorchManager tm = (android.hardware.TorchManager)
+                mContext.getSystemService(Context.TORCH_SERVICE);
+        if (tm == null || !tm.isTorchSupported()) {
+            return false;
+        }
+        if (down) {
+            if (repeatCount > 0) {
+                return mVolumeTorchKeyHandled;
+            }
+            mVolumeTorchKeyHandled = true;
+            mHandler.removeCallbacks(mVolumeTorchLongPress);
+            if (tm.isTorchOn()) {
+                mHandler.removeCallbacks(mVolumeTorchAutoOff);
+                tm.setTorchEnabled(false);
+            } else {
+                if (mVolumeTorchWakeLock == null) {
+                    PowerManager pm = (PowerManager) mContext.getSystemService(
+                            Context.POWER_SERVICE);
+                    mVolumeTorchWakeLock = pm.newWakeLock(
+                            PowerManager.PARTIAL_WAKE_LOCK, "PhoneWindowManager.volumeTorch");
+                    mVolumeTorchWakeLock.setReferenceCounted(false);
+                }
+                mVolumeTorchWakeLock.acquire(2000);
+                mHandler.postDelayed(mVolumeTorchLongPress, 1000);
+            }
+            return true;
+        } else {
+            mHandler.removeCallbacks(mVolumeTorchLongPress);
+            boolean consumed = mVolumeTorchKeyHandled;
+            mVolumeTorchKeyHandled = false;
+            return consumed;
+        }
+    }
+
+    // ---- Camera key: long press launches the camera ----
+    private static final int CAMERA_KEY_LONG_PRESS_MS = 1500;
+
+    private final Runnable mCameraKeyLongPress = new Runnable() {
+        @Override
+        public void run() {
+            try {
+                if (!mCameraLaunch) {
+                    return;
+                }
+                if (!mPowerManager.isInteractive()) {
+                    mPowerManager.wakeUp(SystemClock.uptimeMillis());
+                }
+                WindowState focused = mFocusedWindow;
+                String pkg = (focused != null) ? focused.getOwningPackage() : null;
+                if (pkg != null && pkg.startsWith("com.android.camera")) {
+                    return; // already in the camera
+                }
+                boolean secure = keyguardOn();
+                Intent intent = new Intent(secure
+                        ? android.provider.MediaStore.INTENT_ACTION_STILL_IMAGE_CAMERA_SECURE
+                        : android.provider.MediaStore.INTENT_ACTION_STILL_IMAGE_CAMERA);
+                intent.setFlags(Intent.FLAG_ACTIVITY_NEW_TASK
+                        | Intent.FLAG_ACTIVITY_CLEAR_TOP);
+                mContext.startActivityAsUser(intent, UserHandle.CURRENT);
+            } catch (Exception e) {
+                Slog.w(TAG, "Camera key long press: could not launch camera", e);
+            }
+        }
+    };
+
+    private void handleCameraKeyLongPress(boolean down, int repeatCount) {
+        if (down) {
+            if (repeatCount == 0) {
+                mHandler.removeCallbacks(mCameraKeyLongPress);
+                mHandler.postDelayed(mCameraKeyLongPress, CAMERA_KEY_LONG_PRESS_MS);
+            }
+        } else {
+            mHandler.removeCallbacks(mCameraKeyLongPress);
+        }
+    }
